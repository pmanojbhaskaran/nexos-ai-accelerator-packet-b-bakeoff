// BAKEOFF_ONLY — NOT production schema authority. See GOVERNANCE.md.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// CURRENT_NEXOS_PATTERN (simplified)
model BakeoffTenant {
  tenantCode String @id @map("tenant_code")
  label      String
  createdAt  DateTime @default(now()) @map("created_at")
  @@map("bakeoff_tenant")
}

/// CURRENT_NEXOS_PATTERN (UserIdentity simplified)
model UserIdentity {
  id           String   @id @default(uuid())
  tenantCode   String   @map("tenant_code")
  userCode     String   @map("user_code")
  authSubject  String   @map("auth_subject")
  displayName  String   @map("display_name")
  email        String?
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  roleAssignments UserRoleAssignment[]
  @@unique([tenantCode, authSubject])
  @@unique([tenantCode, userCode])
  @@map("user_identity")
}

model UserRoleAssignment {
  id         String @id @default(uuid())
  tenantCode String @map("tenant_code")
  userCode   String @map("user_code")
  roleCode   String @map("role_code")
  user UserIdentity @relation(fields: [tenantCode, userCode], references: [tenantCode, userCode], onDelete: Cascade)
  @@unique([tenantCode, userCode, roleCode])
  @@map("user_role_assignment")
}

model TenantCapabilityConfig {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  capabilityCode  String  @map("capability_code")
  enabled         Boolean @default(true)
  @@unique([tenantId, capabilityCode])
  @@map("tenant_capability_config")
}

model TenantRolePermission {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  roleCode       String  @map("role_code")
  capabilityCode String  @map("capability_code")
  canView        Boolean @default(true) @map("can_view")
  canCreate      Boolean @default(false) @map("can_create")
  @@unique([tenantId, roleCode, capabilityCode])
  @@map("tenant_role_permission")
}

/// CURRENT_NEXOS_PATTERN (Shipment simplified — synthetic addresses in fixtures only)
model Shipment {
  id                 String @id @default(uuid())
  tenantId           String @map("tenant_id")
  shipmentBusinessId String @map("shipment_business_id")
  status             String @default("CREATED")
  packages           ShipmentPackage[]
  events             ShipmentEvent[]
  @@unique([tenantId, shipmentBusinessId])
  @@map("shipment")
}

/// BAKEOFF_ONLY_REPRESENTATION — physical handling unit (not production ShipmentBox name)
model ShipmentPackage {
  id                 String @id @default(uuid())
  tenantId           String @map("tenant_id")
  shipmentInternalId String @map("shipment_internal_id")
  packageBarcode     String @map("package_barcode")
  label              String
  shipment Shipment @relation(fields: [shipmentInternalId], references: [id], onDelete: Cascade)
  measurements PackageDimensionCapture[]
  @@unique([tenantId, packageBarcode])
  @@map("shipment_package")
}

/// CURRENT_NEXOS_PATTERN (HubInboundScan simplified)
model HubInboundScan {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  shipmentRef   String   @map("shipment_ref")
  barcodeValue  String   @map("barcode_value")
  scanType      String   @map("scan_type")
  scannedBy     String   @map("scanned_by")
  scannedAt     DateTime @map("scanned_at")
  dimensionJson Json?    @map("dimension_json")
  photoRef      String?  @map("photo_ref")
  @@index([tenantId, barcodeValue])
  @@map("hub_inbound_scan")
}

/// BAKEOFF_ONLY_REPRESENTATION — provisional package measurement (Packet C)
model PackageDimensionCapture {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  shipmentId          String   @map("shipment_id")
  packageId           String   @map("package_id")
  measurementSource   String   @map("measurement_source")
  captureMethod       String   @map("capture_method")
  lengthCm            Decimal  @map("length_cm") @db.Decimal(10, 2)
  widthCm             Decimal  @map("width_cm") @db.Decimal(10, 2)
  heightCm            Decimal  @map("height_cm") @db.Decimal(10, 2)
  unit                String   @default("CM")
  qualityResult       String   @map("quality_result")
  confidence          Decimal? @db.Decimal(5, 4)
  decision            String
  billingEligible     Boolean  @default(false) @map("billing_eligible")
  algorithmVersion    String   @map("algorithm_version")
  calibrationVersion  String?  @map("calibration_version")
  deviceId            String   @map("device_id")
  capturedAt          DateTime @map("captured_at")
  capturedBy          String   @map("captured_by")
  evidenceRef         String?  @map("evidence_ref")
  originalJson        Json?    @map("original_json")
  acceptedJson        Json?    @map("accepted_json")
  overrideReason      String?  @map("override_reason")
  correlationId       String   @map("correlation_id")
  package ShipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@map("package_dimension_capture")
}

/// BAKEOFF_ONLY_REPRESENTATION — generic proof artifact (not production ProofFile name)
model ProofArtifact {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  storageKey   String   @map("storage_key")
  contentType  String   @map("content_type")
  capturedAt   DateTime @map("captured_at")
  capturedBy   String   @map("captured_by")
  @@map("proof_artifact")
}

model ShipmentEvent {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  shipmentInternalId String   @map("shipment_internal_id")
  eventType          String   @map("event_type")
  occurredAt         DateTime @map("occurred_at")
  correlationId      String   @map("correlation_id")
  metadata           Json?
  shipment Shipment @relation(fields: [shipmentInternalId], references: [id], onDelete: Cascade)
  @@map("shipment_event")
}

model ShipmentAuditEvent {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  eventName     String @map("event_name")
  actorId       String @map("actor_id")
  entityType    String @map("entity_type")
  entityId      String @map("entity_id")
  correlationId String @map("correlation_id")
  payload       Json
  resultStatus  String @map("result_status")
  @@map("shipment_audit_event")
}

/// BAKEOFF_ONLY_REPRESENTATION
model DomainEventRecord {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  topic         String
  payload       Json
  emittedAt     DateTime @default(now()) @map("emitted_at")
  correlationId String   @map("correlation_id")
  @@map("domain_event_record")
}

/// CURRENT_NEXOS_PATTERN (MobileTaskQueue simplified)
model MobileTaskQueue {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  taskCode   String   @map("task_code")
  assignedTo String   @map("assigned_to")
  status     String   @default("QUEUED")
  shipmentId String?  @map("shipment_id")
  @@unique([tenantId, taskCode])
  @@map("mobile_task_queue")
}

/// BAKEOFF_ONLY_REPRESENTATION
model MobileDevice {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  deviceId   String   @map("device_id")
  platform   String
  registeredAt DateTime @default(now()) @map("registered_at")
  @@unique([tenantId, deviceId])
  @@map("mobile_device")
}

/// BAKEOFF_ONLY_REPRESENTATION
model MobileSyncAction {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  deviceId      String   @map("device_id")
  path          String
  method        String
  bodyJson      Json     @map("body_json")
  status        String   @default("QUEUED")
  idempotencyKey String? @map("idempotency_key")
  queuedAt      DateTime @default(now()) @map("queued_at")
  syncedAt      DateTime? @map("synced_at")
  @@index([tenantId, deviceId, status])
  @@map("mobile_sync_action")
}

model TenantMenuConfig {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  menuCode  String @map("menu_code")
  label     String
  enabled   Boolean @default(true)
  @@unique([tenantId, menuCode])
  @@map("tenant_menu_config")
}
